   "versionNonce": 113614238,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Porquê esta ordem: uma empresa irmã tem um nome quase igual ao da AMT. Se a\nsemelhança decidisse antes da lista de exclusão, a factura seria ambígua ou\nMATCH e a regra R4 ficava violada em silêncio.\nO modelo de linguagem não entra nesta decisão.",
   "originalText": "Porquê esta ordem: uma empresa irmã tem um nome quase igual ao da AMT. Se a\nsemelhança decidisse antes da lista de exclusão, a factura seria ambígua ou\nMATCH e a regra R4 ficava violada em silêncio.\nO modelo de linguagem não entra nesta decisão.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
