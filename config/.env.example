# Copy to config/.env and fill in. Values below are fictitious (SEC-02).
# Every variable is mandatory: the application refuses to start without it (REQ-PLT-007).
# Values with spaces must stay quoted: the file is sourced by the shell in `make run`.

SEXTANTE_ANTHROPIC_API_KEY=replace-with-your-key
SEXTANTE_CATALOG_PATH=../sources/catalog.xlsx
SEXTANTE_DATABASE_URL=sqlite+aiosqlite:///./sextante.db
SEXTANTE_TARGET_ENTITY_NAME="Advanced Maritime Transports - Transitarios Limitada"
# Synthetic value. Replace it with AMT's tax number as printed on its invoices: with a
# different NIF, every AMT invoice is held as ambiguous by the NIF veto (OPEN-ITEMS item 7).
SEXTANTE_TARGET_ENTITY_NIF=5419990000
# Uploaded invoice files. Outside any directory a web server serves (SEC-16).
SEXTANTE_UPLOAD_DIR=./uploads
# Entity denylist, checked before any similarity (REQ-ENT-003). Content awaits AMT (L-04).
SEXTANTE_ENTITY_DENYLIST_PATH=../config/entity_denylist.yaml
# Author of review actions in the audit trail; there is no login in this version (L-07).
SEXTANTE_REVIEWER_ID=revisor-1
# Key every /api call but the health check must send in X-API-Key (L-07). At least 16
# characters; generate one, for example with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEXTANTE_API_KEY=replace-with-a-long-random-key
# Optional. Generic catalog items: choosing one is always LOW and flagged (D-3.16).
# Comma-separated item numbers that must exist in the catalog. Default: O00052.
# SEXTANTE_GENERIC_ITEMS=O00052
# Optional. CSV separator: one of , ; | (REQ-EXP-005). Default: comma.
# SEXTANTE_CSV_SEPARATOR=;
# Optional. Attempts per model call for transient failures, first included (REQ-PLT-003).
# SEXTANTE_MODEL_MAX_ATTEMPTS=3
# Optional. Claude model of the item choice (ticket 11). Default: claude-sonnet-5-5.
# SEXTANTE_MODEL_ID=claude-sonnet-5-5
# Optional. Rate limits per caller (SEC-12); over a limit the answer is 429 with Retry-After.
# SEXTANTE_RATE_LIMIT_GENERAL_PER_MINUTE=300
# SEXTANTE_RATE_LIMIT_UPLOAD_PER_MINUTE=10
# SEXTANTE_RATE_LIMIT_REPROCESS_PER_HOUR=20
# SEXTANTE_RATE_LIMIT_EXPORT_PER_HOUR=30
# SEXTANTE_RATE_LIMIT_CORRECTION_PER_MINUTE=120
# Model calls the worker may make per window; over it invoices wait queued (SEC-12).
# SEXTANTE_MODEL_CALL_CEILING=200
# SEXTANTE_MODEL_CALL_WINDOW_SECONDS=3600
# Limits of reading one PDF in its own process (SEC-16): memory in MiB, time in seconds.
# SEXTANTE_PDF_EXTRACTION_MEMORY_MIB=512
# SEXTANTE_PDF_EXTRACTION_TIMEOUT_SECONDS=30
# Characters per page below which a PDF is refused as scanned (pdf_without_text_layer).
# SEXTANTE_PDF_MIN_CHARS_PER_PAGE=100
# Optional. Local folder with the sample invoices for make golden; never inside the repository.
# SEXTANTE_GOLDEN_SAMPLES_PATH=/path/outside/the/repository/Invoices_sample
