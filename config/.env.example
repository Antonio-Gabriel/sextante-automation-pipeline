# Copy to config/.env and fill in. Values below are fictitious (SEC-02).
# Every variable is mandatory: the application refuses to start without it (REQ-PLT-007).
# Values with spaces must stay quoted: the file is sourced by the shell in `make run`.

SEXTANTE_ANTHROPIC_API_KEY=replace-with-your-key
SEXTANTE_CATALOG_PATH=../sources/catalog.xlsx
SEXTANTE_DATABASE_URL=sqlite+aiosqlite:///./sextante.db
SEXTANTE_TARGET_ENTITY_NAME="Advanced Maritime Transports - Transitarios Limitada"
# Taken from the sample invoices, awaiting confirmation by AMT (OPEN-ITEMS item 7).
SEXTANTE_TARGET_ENTITY_NIF=5419990000
