# Secrets (SEC-03)
.env*
!.env.example
*.pem
*.key

# Invoice data and databases never enter the repository (SEC-03, D-3.18)
*.db
*.db-wal
*.db-shm
uploads/
exports/
# Source files stay local, except the catalog, which ships without its personal
# metadata (author and Windows path stripped; OPEN-ITEMS item 17)
sources/*
!sources/catalog.xlsx

# Python tooling
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Knowledge graph built locally by graphify (regenerated by its git hooks)
graphify-out/

# Claude Code settings of this machine (graphify hooks hold an absolute path)
.claude/settings.local.json
