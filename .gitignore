# Secrets (SEC-03)
.env*
!.env.example
*.pem
*.key

# Invoice data and databases never enter the repository (SEC-03, D-3.18)
*.db
*.db-wal
*.db-shm
uploads/
exports/
# Python tooling
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Knowledge graph built locally by graphify (regenerated by its git hooks)
graphify-out/

# Claude Code settings of this machine (graphify hooks hold an absolute path)
.claude/settings.local.json

# Build contexts and zips assembled for ShardCloud (deploy/shardcloud/build_context.sh)
build/

# Technical documentation PDFs and their Markdown sources stay local, never on GitHub
docs/sextante-documentacao.pt.md
docs/sextante-documentacao.pt.pdf
docs/sextante-documentation.en.md
docs/sextante-documentation.en.pdf
